# Copy to frontend/.env and fill in. All are build-time (VITE_*) — safe to expose (public addrs).

# WalletConnect / Reown project id (free at https://cloud.reown.com)
VITE_WC_PROJECT_ID=

# Deployed contract addresses (from contracts/fingers-deployment.robinhood.json)
VITE_ADDR_GAME=
VITE_ADDR_TOKEN=
VITE_ADDR_WINNER=
VITE_ADDR_LOSER=
VITE_ADDR_NFTSTAKING=
VITE_ADDR_CLAIM=
VITE_ADDR_FSTAKING=
VITE_ADDR_ZAP=
# USDG defaults to the Robinhood address; override only if needed
# VITE_ADDR_USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
